# Скопируйте в .env и заполните. Файл .env в git не попадает.

# Токен бота от @BotFather. Для консольного режима не нужен.
BOT_TOKEN=

# Чат оператора: личный чат или группа, куда пересылаются вопросы вне базы.
# Узнать id можно, написав боту @userinfobot или посмотрев апдейты бота.
OPERATOR_CHAT_ID=

# Кому доступна команда /stats в личке (через запятую). Необязательно.
ADMIN_IDS=

# Провайдер LLM: auto (Claude при наличии ключа, иначе заглушка), anthropic, fake.
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Пути и пороги (можно не трогать).
KNOWLEDGE_DIR=knowledge
DB_PATH=data/dialogs.sqlite3
MIN_OVERLAP=0.3
COMPANY_NAME=автосервис «Вектор»

# Страница метрик: python -m support_bot --metrics
METRICS_HOST=127.0.0.1
METRICS_PORT=8000
